# Copy this file to .env and fill in real values there. .env is gitignored —
# never put real keys or secrets in this file (.env.example) or in any
# committed source file. This is the file that should have existed before
# a key ended up hardcoded in scripts/test_onchain.py.

# --- Trading mode ---
DRY_RUN=true
ALLOW_LIVE=false

# --- Risk parameters ---
MAX_POSITION_USD=5000
MAX_DAILY_LOSS_USD=500
MAX_DAILY_TRADES=10
MAX_LEVERAGE=5.0
MIN_CONFIDENCE_BPS=7000
# Max age (seconds) of the reference price the risk gate will trade against.
# A price older than this is STALE and the order is rejected — the gate never
# trades on a feed it can't trust (oracle trust pattern, ported from liquid-v1).
MAX_PRICE_AGE_SECONDS=60
AGENT_ID=autonomous-trader-001

# --- Order sizing (fractional Kelly) ---
# SIZING_MODE=kelly: size = max_position * (2p - 1) * KELLY_FRACTION, where p
#   is signal confidence. Signals below 50% confidence size to 0 (no trade).
# SIZING_MODE=linear: size = max_position * p (the original behavior).
# KELLY_FRACTION=0.5 = half-Kelly, the standard conservative choice.
SIZING_MODE=kelly
KELLY_FRACTION=0.5

# --- Regime throttle (high-volatility sizing governor) ---
# When a single asset's observed price range over its ring buffer exceeds
# REGIME_BAND_PCT, the effective position cap scales down toward
# REGIME_SIZE_SCALE (0.8 = 20% less room). Sizing-level control, not a halt —
# the kill switch is still the only full-stop. Prices are fed automatically
# by the trading loop.
REGIME_THROTTLE=false
REGIME_BAND_PCT=5.0
REGIME_SIZE_SCALE=0.8

# --- Regime filter (structural-trend guard on signals) ---
# Suppresses mean-reversion LONGs in sustained downtrends (and SHORTs in
# uptrends) and requires momentum crossovers to agree with the longer
# horizon, so the agent stops "buying dips" into structural decline.
# Value = lookback window in bars (default 50; 0 disables). With less
# history than the window the filter is inactive, not blocking.
REGIME_FILTER_WINDOW=50

# --- Delta-neutral funding arbitrage package ---
# A perp whose funding rate is at/above FUNDING_ARB_MIN_RATE (fraction, 0.001
# = 0.1%) runs the long-spot / short-perp package INSTEAD of the directional
# signal path for that cycle. Positive funding only — the package collects
# funding when longs pay shorts; shorting spot to mirror negative funding is
# not expressible. MAX_CONCURRENT_PACKAGES caps open delta-neutral packages.
FUNDING_ARB_MIN_RATE=0.001
MAX_CONCURRENT_PACKAGES=3

# --- API auth (required once DRY_RUN=false — /trade and /kill-switch/*
# refuse to serve without this set) ---
AGENT_API_TOKEN=

# --- OKX exchange credentials (leave blank for dry-run/demo mode) ---
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=

# --- On-chain audit trail (X Layer testnet) ---
# AGENT_WALLET_PRIVATE_KEY must be a key you control and can afford to
# rotate — generate a fresh one for this project, never reuse a key from
# anywhere else, and never paste it into a source file. See
# scripts/set_risk_params.py for the one script that's supposed to touch
# this key.
XLAYER_RPC_URL=https://xlayertestrpc.okx.com
# Optional second, INDEPENDENT endpoint (different operator than the primary).
# Used automatically when the primary refuses to connect. Roadmap Phase 1:
# single-RPC dependency is near-free insurance to fix before real money.
XLAYER_RPC_URL_FALLBACK=
XLAYER_CHAIN_ID=1952
AUDIT_CONTRACT_ADDRESS=
AGENT_WALLET_PRIVATE_KEY=

# --- Alerting (Phase 1: the halt must not exist only in logs) ---
# Generic JSON webhook (POST {event, severity, detail, timestamp}). Fires on
# kill-switch activation/deactivation and durable risk-state write failures.
# Unset = disabled. Works with bare receivers and most relay formats.
ALERT_WEBHOOK_URL=
# Min seconds between repeat alerts of the same event type (kill-switch
# events use a fixed 5s cooldown). Default 300.
ALERT_COOLDOWN_SECONDS=300

# --- Phase 1.5: Pre-signal data integrity gate ---
# Max age (seconds) of the price/funding feed before the integrity gate
# HARD_BLOCKs the asset. Runs BEFORE signal generation: stale/NaN inputs are
# caught before a signal is ever built on them (not after, at the risk gate).
DATA_STALENESS_SECONDS=30

# --- Local audit trail (append-only JSONL) ---
# Every curator switch, integrity block, confidence-floor skip, and risk-gate
# rejection is appended here alongside the on-chain decision log.
AUDIT_LOG_PATH=audit_log.jsonl

# --- Curator profile (default-passthrough per-knob env overrides) ---
# The active profile (config/profiles.yaml) is the default for every knob.
# Set any of these to override ONLY that knob for the running process; leave
# blank to use the profile value. A bad/castable value falls back to the
# profile value — bad env can never break the trading loop.
CURATOR_POSITION_SIZE_MULTIPLIER=
CURATOR_CONFIDENCE_FLOOR_BPS=
CURATOR_MAX_LEVERAGE=

# --- x402 payments (optional) ---
PAY_TO_ADDRESS=
